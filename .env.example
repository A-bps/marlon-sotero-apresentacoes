# URL pública do site (usada para montar o link do cliente e as imagens de compartilhamento).
NEXT_PUBLIC_SITE_URL=https://apresentacoes.exemplo.com.br

# Envio de leads por e-mail via Resend (https://resend.com). Sem estas variáveis, /api/leads responde 503.
RESEND_API_KEY=re_exemplo_nao_e_uma_chave_real
LEAD_TO_EMAIL=contato@exemplo.com.br
# Remetente verificado no Resend. Opcional; padrão: onboarding@resend.dev (apenas para testes).
LEAD_FROM_EMAIL=Apresentações <leads@exemplo.com.br>
